extends "res://tests/campari_render.gd"

func automatic_early_girl(id: String = "early_girl") -> Tomato:
	game.clear_field(); game.session.launch_clock = 1000; game.fragments.set_physics_process(false)
	var fruit: Tomato
	for i in range(500):
		game.clear_field(); fruit = game.spawn_tomato()
		if fruit.variety_id == id: break
	fruit.set_physics_process(false); return fruit

func run() -> void:
	create_timer(480).timeout.connect(func(): push_error("Nakiri native checks timed out"); quit(1))
	DirAccess.make_dir_recursive_absolute(output)
	game = load("res://scenes/main.tscn").instantiate(); game.save_path = "user://tests/nakiri-render.json"
	for suffix: String in ["", ".bak"]:
		if FileAccess.file_exists(game.save_path+suffix): DirAccess.remove_absolute(game.save_path+suffix)
	root.add_child(game); await frames(); game.progress.money = 50000
	await click(find_button(game.ui.content,"Seed catalog")); await click(find_button(game.ui.content,"Money")); await cultivate("better_prices")
	await click(find_button(game.ui.content,"Harvest")); await cultivate("faster_throwing"); await click(find_button(game.ui.content,"Cutting")); await cultivate("sharp_edge"); await cultivate("extra_cuts"); await click(find_button(game.ui.content,"Varieties"))
	for id: String in ["unlock_cherry","unlock_roma","roma_quality","cherry_frequency","unlock_grape","grape_frequency","unlock_campari","campari_frequency","cherry_quality","cherry_quality","unlock_cocktail","cocktail_quality","roma_quality","unlock_plum","plum_quality","campari_frequency","unlock_beefsteak","beefsteak_quality","plum_frequency","plum_frequency","unlock_big_boy","big_boy_quality","beefsteak_frequency","beefsteak_frequency","unlock_better_boy","better_boy_quality","cocktail_frequency","cocktail_frequency"]: await cultivate(id)
	check(game.ui.content.find_child("Specimen_early_girl",true,false) == null,"native Early Girl stays hidden until paid Better Boy quality and third Cocktail frequency gates are met")
	await cultivate("cocktail_frequency"); await focus_specimen("early_girl")
	check(not game.progress.harvest.unlocked("early_girl",game.progress.levels) and game.ui.content.find_child("HarvestStatus_early_girl",true,false).text.contains("Awaiting") and game.ui.content.find_child("HarvestReadiness_early_girl",true,false).text.contains("1.67"),"native botanical invitation honestly shows both the unpaid unlock and current cutting-power requirement")
	await capture("273-early_girl-invitation"); var money: float = game.progress.money; await cultivate("unlock_early_girl")
	check(game.progress.money == money-6000 and game.progress.harvest.unlocked("early_girl",game.progress.levels) and not game.progress.harvest_distribution().has("early_girl"),"actual saved 6000-dollar native unlock grants ownership while retaining the ordinary three-strike safety")
	await cultivate("early_girl_quality"); await cultivate("early_girl_frequency"); root.size = Vector2i(1280,720); await frames(); await focus_specimen("early_girl")
	var readiness: Label = game.ui.content.find_child("HarvestReadiness_early_girl",true,false)
	check(root.get_visible_rect().encloses(readiness.get_global_rect()) and game.ui.content.find_child("HarvestStatus_early_girl",true,false).text.contains("needs more sharpness") and game.ui.content.find_child("Purchase_early_girl_dominance",true,false) == null,"native eleven-variety root catalog fits honest blocked readiness at 16:9 while advanced orders remain hidden")
	var map: RootMap = game.ui.content.get_node("CatalogScroll"); var zoom := map.zoom; money = game.progress.money
	await wheel_list(game.ui.content.get_node("HarvestMixScroll"))
	check(map.zoom == zoom and game.progress.money == money and game.ui.content.get_node("HarvestMixScroll").scroll_vertical > 0,"actual native fast fruit reference scrolls independently without changing root zoom, buying produce or bypassing strength")
	await capture("274-early_girl-awaiting-strength"); await click(instrument_icon()); await frames(6)
	var product: Button = game.ui.content.find_child("Product_nakiri",true,false); game.ui.content.find_child("Product_rusty_butter",true,false).grab_focus()
	for i in range(10):
		for down: bool in [true,false]:
			var key := InputEventKey.new(); key.keycode = KEY_TAB; key.pressed = down; Input.parse_input_event(key)
		await frames(1)
	await frames()
	check(root.gui_get_focus_owner() == product and game.ui.content.get_node("KnifeCollectionScroll").get_global_rect().encloses(product.get_global_rect()),"ten real native Tab presses expose the eleventh instrument inside the bounded collection")
	await click(product); await frames(6)
	check(game.progress.equipped_knife == "rusty_butter" and not game.progress.harvest.can_handle(game.progress.harvest.definition("early_girl"),game.progress.strength()),"actual original Nakiri preview grants neither heavy cutting power nor a normal spawn")
	await capture("275-nakiri-product-study"); money = game.progress.money; await click(game.ui.content.find_child("Buy_nakiri",true,false))
	check(game.progress.money == money-3600 and game.progress.owned_knives == ["rusty_butter","nakiri"] and game.progress.equipped_knife == "rusty_butter","actual saved native Nakiri purchase spends 3600 dollars while keeping equip and readiness separate")
	await select_product("paring"); await click(game.ui.content.find_child("Buy_paring",true,false)); await click(game.ui.content.find_child("Equip_paring",true,false))
	check(game.progress.strength() == 1.75 and game.progress.harvest_distribution().has("early_girl"),"actual paid precision knife plus cultivated strength satisfies the same ordinary fast fruit safety gate")
	await click(catalog_icon()); await click(find_button(game.ui.content,"Varieties")); await focus_specimen("early_girl")
	check(game.ui.content.find_child("HarvestReadiness_early_girl",true,false) == null and game.ui.content.find_child("HarvestStatus_early_girl",true,false).text.contains("automatically available"),"actual native equipment change removes obsolete readiness warnings and updates the eleven-variety automatic reference")
	await capture("276-early_girl-ready-reference"); await click(find_button(game.ui.content,"Back to the cutting board")); game.set_physics_process(false)
	var fruit := automatic_early_girl(); var start := fruit.position; var initial_rotation := fruit.rotation; var family: CutFamily = fruit.family
	for step in range(60): fruit._physics_process(1.0/60)
	check(fruit.variety_id == "early_girl" and fruit.position.y > start.y and (fruit.rotation-initial_rotation).is_equal_approx(fruit.spin) and family.mass == .95 and family.cut_value == 200,"actual eligible automatic Early Girl flies with its authored light mass, measured arc, spin and cultivated value")
	await capture("277-moving-early_girl"); pose(fruit); var camera_pose: Transform3D = game.kitchen.camera.global_transform
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(fruit.durability == 3.25 and game.session.cuts == 0 and game.session.earnings == 0,"actual native precision-knife hit damages the fast fruit without paying before a split")
	await capture("278-early_girl-resistance"); await move_blade(Vector2(-3,0))
	check(game.ui.moving.filter(func(item): return item.get("group","") == game.resistance_group(family)).size() == 1,"rapid native fast fruit damage updates one current family-local resistance label")
	await move_blade(Vector2(3,0))
	check(game.session.cuts == 1 and game.session.earnings == 250 and game.session.tomatoes_sliced == 1 and game.ui.moving.filter(func(item): return item.get("group","") == game.resistance_group(family)).is_empty(),"three actual native precision strokes split Early Girl for 250 and retire obsolete damage feedback")
