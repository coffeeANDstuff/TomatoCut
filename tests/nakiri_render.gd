	check(game.fragments.pieces.size() == 2 and game.fragments.pieces[0].position.distance_to(game.fragments.pieces[1].position) > .1,"actual compact Early Girl halves separate and tumble with their own three kidney-gallery interiors")
	await capture("279-early_girl-open-interiors"); var at: Vector3 = game.fragments.pieces[0].global_position; game.knife.reset()
	await move_blade(Vector2(at.x-2,at.y)); await move_blade(Vector2(at.x+2,at.y))
	check(game.session.cuts == 1 and game.fragments.pieces[0].durability == 1.25,"actual native fast fruit half retains its own 3 resistance before recut income")
	await move_blade(Vector2(at.x-2,at.y)); await move_blade(Vector2(at.x+2,at.y))
	check(game.session.cuts == 2 and game.session.earnings == 500 and game.session.tomatoes_sliced == 1 and game.kitchen.camera.global_transform == camera_pose,"actual resistant fast fruit recut retains 500 per family, unique accounting and the fixed camera")
	game.session.advance(100); game.finish_round(); await frames(); await click(instrument_icon()); await select_product("cleaver"); await click(game.ui.content.find_child("Buy_cleaver",true,false)); await click(game.ui.content.find_child("Equip_cleaver",true,false))
	await click(find_button(game.ui.content,"Back to the cutting board")); fruit = automatic_early_girl(); pose(fruit); await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(game.progress.strength() == 4.5 and fruit.durability == .5 and game.session.cuts == 0,"actual native ordinary Cleaver at the same 4.50 sharpness leaves Early Girl resistance without a payout")
	await capture("280-cleaver-early_girl-resistance"); await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0)); game.session.advance(100); game.finish_round(); await frames(); await click(instrument_icon()); await select_product("nakiri"); await click(game.ui.content.find_child("Equip_nakiri",true,false))
	check(game.progress.strength() == 4.5 and game.progress.cutting_profile().normal_damage(5,"early_girl") == 5.625 and "Active" in game.ui.content.find_child("EquipmentSpecial",true,false).text,"actual saved native Nakiri equip activates normal-produce damage while keeping raw sharpness and combo separate")
	await click(find_button(game.ui.content,"Back to the cutting board")); fruit = automatic_early_girl(); pose(fruit)
	await move_blade(Vector2(-1.85,0)); await move_blade(Vector2(-1.81,0))
	check(game.session.cuts == 1 and game.session.earnings == 250 and game.knife.edge.size() == 4 and game.audio.players[(game.audio.cursor-1)%8].stream == game.audio.sounds.nakiri_slice,"actual squared Nakiri toe splits Early Girl with the cursor outside the hull, specialized damage and its original cue")
	await capture("281-nakiri-vegetable-toe"); await move_blade(Vector2(-3,0)); game.session.advance(100); game.finish_round(); await frames(); var restored := Progression.new()
	check(game.store.load_into(restored) and restored.equipped_knife == "nakiri" and restored.prestige.cycle_earnings == 1500 and restored.cutting_profile().normal_damage(5,"early_girl") == 5.625,"three real native Paring/Cleaver/Nakiri families keep 1500 exact saved income without a specialist money bonus")
	await capture("282-nakiri-early_girl-results"); await click(find_button(game.ui.content,"Play again")); game.set_physics_process(false); fruit = automatic_early_girl("big_boy"); pose(fruit); await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(is_equal_approx(fruit.durability,.375) and game.session.cuts == 0,"actual unprepared specialist still needs a second accepted strike on six-resistance Big Boy")
	await capture("283-nakiri-big_boy-threshold"); game.session.advance(100); game.finish_round(); await frames(); await click(instrument_icon()); await select_product("nakiri"); await click(game.ui.content.find_child("Prepare_nakiri",true,false))
	await click(game.ui.content.find_child("BuyModification_honing_kit",true,false)); await click(game.ui.content.find_child("Apply_honing_kit",true,false))
	check(game.progress.strength() == 5 and game.progress.knife_modification("nakiri") == "honing_kit" and game.progress.cutting_profile().normal_damage(6,"big_boy") == 6.25,"separate actual native preparation composes once before produce specialization and reaches the tough-fruit clean threshold")
	await capture("284-nakiri-assigned-preparation"); await click(catalog_icon()); await click(find_button(game.ui.content,"Cutting")); await game.ui.focus_control(game.ui.content.find_child("Purchase_sharp_edge",true,false)); await frames(6)
	check(game.ui.content.find_child("CurrentProduceDamage",true,false).text.contains("6.25 → 6.88") and game.ui.content.find_child("CurrentCutting_sharp_edge",true,false).text.contains("5.00 → 5.50"),"native Sharp Edge order honestly distinguishes current-next raw sharpness from actual normal-produce damage")
	await capture("285-nakiri-produce-forecast"); await click(instrument_icon()); await select_product("nakiri"); await click(find_button(game.ui.content,"Back to the cutting board")); fruit = automatic_early_girl("big_boy"); pose(fruit); await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(game.session.cuts == 1 and game.session.earnings == 125,"actual prepared Nakiri cleanly splits Big Boy while retaining its ordinary cultivated cut value")
	await move_blade(Vector2(-3,0)); game.session.advance(100); game.finish_round(); await frames()
	check(game.store.load_into(restored) and restored.prestige.cycle_earnings == 1750 and restored.strength() == 5,"real prepared root/recut bank another ordinary 250 and reload assigned preparation with all prior earned money")
	await capture("286-nakiri-prepared-results"); await click(instrument_icon()); await select_product("bread"); await click(game.ui.content.find_child("Buy_bread",true,false)); await click(game.ui.content.find_child("Equip_bread",true,false))
	check(game.progress.cutting_profile().produce_multiplier == 1 and game.progress.cutting_profile().normal_damage(5,"early_girl") == 5.25 and game.progress.cutting_profile().normal_damage(1,"standard_red") == 3.5,"actual native Bread swap removes vegetable specialization and retains only its own resistant-target damage")
	await select_product("santoku"); await click(game.ui.content.find_child("Buy_santoku",true,false)); await click(game.ui.content.find_child("Equip_santoku",true,false)); await click(catalog_icon()); await click(find_button(game.ui.content,"Money")); await cultivate("better_prices"); await click(find_button(game.ui.content,"Combos")); await cultivate("combo_cash")
	check(game.progress.equipped_combo_multiplier() == 1.5 and game.progress.reward(2,200) == 322.5,"actual native Santoku retains its independently cultivated earned-combo benefit beside the new vegetable specialist")
	await click(instrument_icon()); await select_product("nakiri"); await click(game.ui.content.find_child("Equip_nakiri",true,false))
	check(game.progress.equipped_combo_multiplier() == 1 and game.progress.reward(2,200) == 315 and game.progress.strength() == 5,"actual native Nakiri swap removes Santoku combo but retains its own assigned preparation without multiplying money")
	game.progress.complete_round(float(game.progress.prestige.config.threshold),1,1); await click(archive_icon()); await click(game.ui.content.find_child("PreviewPrestige",true,false)); game.ui.prestige_confirmation.get_ok_button().pressed.emit(); await frames(6)
	check(not game.progress.harvest.unlocked("early_girl",game.progress.levels) and game.progress.owned_knives == ["rusty_butter"] and game.progress.cutting_profile().produce_multiplier == 1 and game.progress.owned_modifications.is_empty(),"native confirmed prestige clears fast variety, specialist inventory/preparation and derived produce damage")
	await permanent("permanent_slice_value"); game.show_settings(); await frames(); await click(game.ui.content.find_child("Setting_reduced_motion",true,false)); await click(game.ui.content.find_child("Setting_reduced_effects",true,false)); await click(instrument_icon()); await select_product("nakiri")
	check(not game.ui.content.get_node("EquipmentPreview").is_processing() and "When equipped" in game.ui.content.find_child("EquipmentSpecial",true,false).text and game.progress.cutting_profile().produce_multiplier == 1,"new-cycle Nakiri remains a fully framed still unowned study with no gifted active specialization")
	await capture("287-nakiri-reduced-motion"); game.show_home(); await frames(); await click(find_button(game.ui.content,"New game")); game.ui.confirmation.get_ok_button().pressed.emit(); await frames(6)
	check(game.progress.prestige.levels.is_empty() and game.ui.root_views.is_empty() and game.progress.settings.reduced_motion and game.progress.settings.reduced_effects,"native New Game clears new normal/permanent gates while retaining accessibility preferences")
	game.queue_free(); await frames(12); await create_timer(.25).timeout; print("NAKIRI RENDER RESULT: ",failures," failures"); quit(1 if failures else 0)
