extends "res://tests/campari_render.gd"

func automatic_better_boy() -> Tomato:
	game.clear_field(); game.session.launch_clock = 1000; game.fragments.set_physics_process(false)
	var fruit: Tomato
	for i in range(500):
		game.clear_field(); fruit = game.spawn_tomato()
		if fruit.variety_id == "better_boy": break
	fruit.set_physics_process(false); return fruit

func run() -> void:
	create_timer(480).timeout.connect(func(): push_error("Fillet Knife native checks timed out"); quit(1))
	DirAccess.make_dir_recursive_absolute(output)
	game = load("res://scenes/main.tscn").instantiate(); game.save_path = "user://tests/fillet-render.json"
	for suffix: String in ["", ".bak"]:
		if FileAccess.file_exists(game.save_path+suffix): DirAccess.remove_absolute(game.save_path+suffix)
	root.add_child(game); await frames(); game.progress.money = 50000
	await click(find_button(game.ui.content,"Seed catalog")); await click(find_button(game.ui.content,"Money")); await cultivate("better_prices")
	await click(find_button(game.ui.content,"Harvest")); await cultivate("faster_throwing"); await click(find_button(game.ui.content,"Cutting")); await cultivate("sharp_edge"); await cultivate("extra_cuts"); await click(find_button(game.ui.content,"Varieties"))
	for id: String in ["unlock_cherry","unlock_roma","roma_quality","cherry_frequency","unlock_grape","grape_frequency","unlock_campari","campari_frequency","cherry_quality","cherry_quality","unlock_cocktail","cocktail_quality","roma_quality","unlock_plum","plum_quality","campari_frequency","unlock_beefsteak","beefsteak_quality","plum_frequency","plum_frequency","unlock_big_boy","big_boy_quality","beefsteak_frequency"]: await cultivate(id)
	check(game.ui.content.find_child("Specimen_better_boy",true,false) == null,"native Better Boy stays hidden until both real Big Boy quality and second Beefsteak frequency gates are paid")
	await cultivate("beefsteak_frequency"); await focus_specimen("better_boy")
	check(not game.progress.harvest.unlocked("better_boy",game.progress.levels) and game.ui.content.find_child("HarvestStatus_better_boy",true,false).text.contains("Awaiting") and game.ui.content.find_child("HarvestReadiness_better_boy",true,false).text.contains("1.67"),"native botanical invitation honestly shows both the unpaid unlock and current cutting-power requirement")
	await capture("260-better_boy-invitation"); var money: float = game.progress.money; await cultivate("unlock_better_boy")
	check(game.progress.money == money-3800 and game.progress.harvest.unlocked("better_boy",game.progress.levels) and not game.progress.harvest_distribution().has("better_boy"),"actual saved 3800-dollar native unlock grants ownership while retaining the ordinary three-strike safety")
	await cultivate("better_boy_quality"); await cultivate("better_boy_frequency"); root.size = Vector2i(1280,720); await frames(); await focus_specimen("better_boy")
	var readiness: Label = game.ui.content.find_child("HarvestReadiness_better_boy",true,false)
	check(root.get_visible_rect().encloses(readiness.get_global_rect()) and game.ui.content.find_child("HarvestStatus_better_boy",true,false).text.contains("needs more sharpness") and game.ui.content.find_child("Purchase_better_boy_dominance",true,false) == null,"native ten-variety root catalog fits honest blocked readiness at 16:9 while advanced orders remain hidden")
	var map: RootMap = game.ui.content.get_node("CatalogScroll"); var zoom := map.zoom; money = game.progress.money
	await wheel_list(game.ui.content.get_node("HarvestMixScroll"))
	check(map.zoom == zoom and game.progress.money == money and game.ui.content.get_node("HarvestMixScroll").scroll_vertical > 0,"actual native heavyweight reference scrolls independently without changing root zoom, buying produce or bypassing strength")
	await capture("261-better_boy-awaiting-strength"); await click(instrument_icon()); await frames(6)
	var product: Button = game.ui.content.find_child("Product_fillet",true,false); game.ui.content.find_child("Product_rusty_butter",true,false).grab_focus()
	for i in range(9):
		for down: bool in [true,false]:
			var key := InputEventKey.new(); key.keycode = KEY_TAB; key.pressed = down; Input.parse_input_event(key)
		await frames(1)
	await frames()
	check(root.gui_get_focus_owner() == product and game.ui.content.get_node("KnifeCollectionScroll").get_global_rect().encloses(product.get_global_rect()),"nine real native Tab presses expose the tenth instrument inside the bounded collection")
	await click(product); await frames(6)
	check(game.progress.equipped_knife == "rusty_butter" and not game.progress.harvest.can_handle(game.progress.harvest.definition("better_boy"),game.progress.strength()),"actual original Fillet Knife preview grants neither heavy cutting power nor a normal spawn")
	await capture("262-fillet-product-study"); money = game.progress.money; await click(game.ui.content.find_child("Buy_fillet",true,false))
	check(game.progress.money == money-2300 and game.progress.owned_knives == ["rusty_butter","fillet"] and game.progress.equipped_knife == "rusty_butter","actual saved native Fillet Knife purchase spends 2300 dollars while keeping equip and readiness separate")
	await select_product("paring"); await click(game.ui.content.find_child("Buy_paring",true,false)); await click(game.ui.content.find_child("Equip_paring",true,false))
	check(game.progress.strength() == 1.75 and game.progress.harvest_distribution().has("better_boy"),"actual paid precision knife plus cultivated strength satisfies the same ordinary heavyweight safety gate")
	await click(catalog_icon()); await click(find_button(game.ui.content,"Varieties")); await focus_specimen("better_boy")
	check(game.ui.content.find_child("HarvestReadiness_better_boy",true,false) == null and game.ui.content.find_child("HarvestStatus_better_boy",true,false).text.contains("automatically available"),"actual native equipment change removes obsolete readiness warnings and updates the ten-variety automatic reference")
	await capture("263-better_boy-ready-reference"); await click(find_button(game.ui.content,"Back to the cutting board")); game.set_physics_process(false)
	var fruit := automatic_better_boy(); var start := fruit.position; var initial_rotation := fruit.rotation; var family: CutFamily = fruit.family
	for step in range(60): fruit._physics_process(1.0/60)
	check(fruit.variety_id == "better_boy" and fruit.position.y > start.y and (fruit.rotation-initial_rotation).is_equal_approx(fruit.spin) and family.mass == 2.1 and family.cut_value == 175,"actual eligible automatic Better Boy flies with its authored heavy mass, measured arc, spin and cultivated value")
	await capture("264-moving-better_boy"); pose(fruit); var camera_pose: Transform3D = game.kitchen.camera.global_transform
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(fruit.durability == 3.25 and game.session.cuts == 0 and game.session.earnings == 0,"actual native precision-knife hit damages the heavyweight without paying before a split")
	await capture("265-better_boy-resistance"); await move_blade(Vector2(-3,0))
	check(game.ui.moving.filter(func(item): return item.get("group","") == game.resistance_group(family)).size() == 1,"rapid native heavyweight damage updates one current family-local resistance label")
	await move_blade(Vector2(3,0))
	check(game.session.cuts == 1 and game.session.earnings == 218.75 and game.session.tomatoes_sliced == 1 and game.ui.moving.filter(func(item): return item.get("group","") == game.resistance_group(family)).is_empty(),"three actual native precision strokes split Better Boy for 218.75 and retire obsolete damage feedback")
	for step in range(18): game.fragments._physics_process(1.0/60)
	check(game.fragments.pieces.size() == 2 and game.fragments.pieces[0].position.distance_to(game.fragments.pieces[1].position) > .1,"actual heavy Better Boy halves separate and tumble with their own meaty five-chamber interiors")
	await capture("266-better_boy-open-interiors"); var at: Vector3 = game.fragments.pieces[0].global_position; game.knife.reset()
	await move_blade(Vector2(at.x-2,at.y)); await move_blade(Vector2(at.x+2,at.y))
	check(game.session.cuts == 1 and game.fragments.pieces[0].durability == .75,"actual native heavyweight half retains its own 2.5 resistance before recut income")
	await move_blade(Vector2(at.x-2,at.y)); await move_blade(Vector2(at.x+2,at.y))
	check(game.session.cuts == 2 and game.session.earnings == 437.5 and game.session.tomatoes_sliced == 1 and game.kitchen.camera.global_transform == camera_pose,"actual resistant heavyweight recut retains 437.50 per family, unique accounting and the fixed camera")
	game.session.advance(100); game.finish_round(); await frames(); await click(instrument_icon()); await select_product("fillet"); await click(game.ui.content.find_child("Equip_fillet",true,false))
	check(game.progress.strength() == 4 and game.progress.equipped_combo_multiplier() == 1,"actual saved native Fillet Knife equip composes precision base and ordinary sharpness without a value passive")
	await click(find_button(game.ui.content,"Back to the cutting board")); fruit = automatic_better_boy(); pose(fruit)
	await move_blade(Vector2(-1.95,0)); await move_blade(Vector2(-1.91,0))
	check(fruit.durability == 1 and game.session.cuts == 0 and game.knife.edge.size() == 5,"actual fine upswept blade leaves one point Better Boy resistance without a premature reward")
	await capture("272-fillet-precision-tip")
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(game.session.cuts == 2 and game.session.earnings == 437.5,"actual unprepared Fillet Knife root/recut need fewer accepted strikes while keeping the same payout")
	await capture("267-fillet-heavy-recut"); game.session.advance(100); game.finish_round(); await frames(); await click(instrument_icon()); await select_product("fillet"); await click(game.ui.content.find_child("Prepare_fillet",true,false))
	await click(game.ui.content.find_child("BuyModification_honing_kit",true,false)); await click(game.ui.content.find_child("Apply_honing_kit",true,false))
	check(game.progress.strength() == 4.5 and game.progress.knife_modification("fillet") == "honing_kit","actual separate native Fillet preparation adds strength once without promising an unearned clean root")
	await click(catalog_icon()); await click(find_button(game.ui.content,"Cutting")); await game.ui.focus_control(game.ui.content.find_child("Purchase_sharp_edge",true,false)); await frames(6)
	check(game.ui.content.find_child("CurrentCutting_sharp_edge",true,false).text.contains("4.50 → 5.00"),"native actual sharpness order previews prepared precision damage before spending")
	await capture("271-fillet-sharpness-order"); money = game.progress.money; var cultivation_cost: float = game.progress.price("sharp_edge"); await cultivate("sharp_edge")
	check(game.progress.money == money-cultivation_cost and game.progress.strength() == 5,"native paid ordinary sharpness plus assigned preparation reach the premium five-resistance threshold once")
	await click(instrument_icon()); await select_product("fillet"); await click(game.ui.content.find_child("Prepare_fillet",true,false))
	await capture("268-prepared-fillet"); await click(find_button(game.ui.content,"Back to cutting")); fruit = automatic_better_boy(); pose(fruit)
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(game.session.cuts == 1 and game.session.earnings == 218.75 and game.audio.players[(game.audio.cursor-1)%8].stream == game.audio.sounds.fillet_slice,"actual prepared Fillet Knife makes a single clean heavy-root split and dispatches its original chop cue")
	await move_blade(Vector2(-3,0)); game.session.advance(100); game.finish_round(); await frames(); var restored := Progression.new()
	check(game.store.load_into(restored) and restored.equipped_knife == "fillet" and restored.strength() == 5 and restored.prestige.cycle_earnings == 1312.5,"three actual native precision/heavy/prepared rounds bank 1312.50 and reload paid Better Boy/Fillet Knife/preparation")
	await capture("269-fillet-results"); await click(instrument_icon()); await select_product("santoku"); await click(game.ui.content.find_child("Buy_santoku",true,false)); await click(game.ui.content.find_child("Equip_santoku",true,false))
	await click(catalog_icon()); await click(find_button(game.ui.content,"Money")); await cultivate("better_prices"); await click(find_button(game.ui.content,"Combos")); await cultivate("combo_cash")
	check(game.progress.equipped_combo_multiplier() == 1.5 and game.progress.reward(2,175) == 282.19,"actual native separately equipped and cultivated Santoku retains its own earned combo benefit")
	await click(instrument_icon()); await select_product("fillet"); await click(game.ui.content.find_child("Equip_fillet",true,false))
	check(game.progress.equipped_combo_multiplier() == 1 and game.progress.reward(2,175) == 275.63 and game.progress.strength() == 5,"actual native return to Fillet Knife removes Santoku's passive and keeps the heavy knife's assigned preparation")
	game.progress.complete_round(float(game.progress.prestige.config.threshold),1,1); await click(archive_icon()); await click(game.ui.content.find_child("PreviewPrestige",true,false)); game.ui.prestige_confirmation.get_ok_button().pressed.emit(); await frames(6)
	check(not game.progress.harvest.unlocked("better_boy",game.progress.levels) and game.progress.owned_knives == ["rusty_butter"] and game.progress.owned_modifications.is_empty() and game.ui.list_views.is_empty(),"native confirmed prestige clears new heavyweight ownership/equipment/preparation and stale collection views")
	await permanent("permanent_slice_value"); game.show_settings(); await frames(); await click(game.ui.content.find_child("Setting_reduced_motion",true,false)); await click(game.ui.content.find_child("Setting_reduced_effects",true,false)); await click(instrument_icon()); await select_product("fillet")
	check(not game.ui.content.get_node("EquipmentPreview").is_processing() and game.ui.content.find_child("EquipmentSpecial",true,false).text == "Special  ·  None","new-cycle heavy Fillet Knife remains an unowned still product study with no gifted special")
	await capture("270-fillet-reduced-motion"); game.show_home(); await frames(); await click(find_button(game.ui.content,"New game")); game.ui.confirmation.get_ok_button().pressed.emit(); await frames(6)
	check(game.progress.prestige.levels.is_empty() and game.ui.root_views.is_empty() and game.progress.settings.reduced_motion and game.progress.settings.reduced_effects,"native New Game clears all gates while retaining accessibility preferences")
	game.queue_free(); await frames(12); await create_timer(.25).timeout; print("FILLET RENDER RESULT: ",failures," failures"); quit(1 if failures else 0)
