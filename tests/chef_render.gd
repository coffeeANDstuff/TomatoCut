extends "res://tests/campari_render.gd"

func automatic_plum() -> Tomato:
	game.clear_field(); game.session.launch_clock = 1000; game.fragments.set_physics_process(false)
	var fruit: Tomato
	for i in range(300):
		game.clear_field(); fruit = game.spawn_tomato()
		if fruit.variety_id == "plum": break
	fruit.set_physics_process(false); return fruit

func run() -> void:
	create_timer(360).timeout.connect(func(): push_error("Chef native checks timed out"); quit(1))
	DirAccess.make_dir_recursive_absolute(output)
	game = load("res://scenes/main.tscn").instantiate(); game.save_path = "user://tests/chef-render.json"
	for suffix: String in ["", ".bak"]:
		if FileAccess.file_exists(game.save_path+suffix): DirAccess.remove_absolute(game.save_path+suffix)
	root.add_child(game); await frames(); game.progress.money = 30000
	await click(find_button(game.ui.content,"Seed catalog")); await click(find_button(game.ui.content,"Money")); await cultivate("better_prices")
	await click(find_button(game.ui.content,"Harvest")); await cultivate("faster_throwing"); await click(find_button(game.ui.content,"Cutting")); await cultivate("sharp_edge"); await cultivate("extra_cuts"); await click(find_button(game.ui.content,"Varieties"))
	for id: String in ["unlock_cherry","unlock_roma","roma_quality","cherry_frequency","unlock_grape","grape_frequency","unlock_campari","campari_frequency","cherry_quality","cherry_quality","unlock_cocktail","cocktail_quality"]: await cultivate(id)
	check(game.ui.content.find_child("Specimen_plum",true,false) == null,"native Plum stays hidden before both paid Roma quality and Cocktail quality predecessors")
	await cultivate("roma_quality"); await focus_specimen("plum")
	check(not game.progress.harvest.unlocked("plum",game.progress.levels) and not game.progress.harvest.distribution(game.progress.levels,game.progress.strength()).has("plum"),"native original Plum study reveals without free normal harvest ownership")
	await capture("227-plum-invitation"); var money: float = game.progress.money; await cultivate("unlock_plum")
	check(game.progress.money == money-780 and game.progress.harvest.unlocked("plum",game.progress.levels),"actual native Plum unlock spends its authored 780 dollars")
	await cultivate("plum_quality"); await cultivate("plum_frequency"); root.size = Vector2i(1280,720); await frames(); await focus_specimen("plum")
	var share: Label = game.ui.content.find_child("SpawnShare_plum",true,false)
	check(root.get_visible_rect().encloses(share.get_global_rect()) and game.ui.content.find_child("Purchase_plum_dominance",true,false) == null,"seven-variety native roots retain readable automatic Plum forecasts and hidden advanced orders at 16:9")
	await capture("228-plum-specimen-16x9"); await click(instrument_icon()); await frames(6)
	var product: Button = game.ui.content.find_child("Product_chef",true,false); game.ui.content.find_child("Product_rusty_butter",true,false).grab_focus()
	for i in range(6):
		for down: bool in [true,false]:
			var key := InputEventKey.new(); key.keycode = KEY_TAB; key.pressed = down; Input.parse_input_event(key)
		await frames(1)
	await frames()
	check(root.gui_get_focus_owner() == product and game.ui.content.get_node("KnifeCollectionScroll").get_global_rect().encloses(product.get_global_rect()),"six actual native Tab presses expose the seventh instrument without covering the printed footer")
	await click(product); await frames(6)
	check(game.progress.equipped_knife == "rusty_butter" and game.ui.content.find_child("EquipmentSpecial",true,false).text == "Special  ·  None","native forged Chef product shows real strength/reach without granting a borrowed passive during browsing")
	await capture("229-chef-product-study"); money = game.progress.money; await click(game.ui.content.find_child("Buy_chef",true,false))
	check(game.progress.money == money-500 and game.progress.owned_knives == ["rusty_butter","chef"] and game.progress.equipped_knife == "rusty_butter","actual native saved Chef purchase buys ownership for 500 dollars and leaves equip separate")
	await click(find_button(game.ui.content,"Back to the cutting board")); game.set_physics_process(false)
	var fruit := automatic_plum(); var start := fruit.position; var initial_rotation := fruit.rotation
	for step in range(60): fruit._physics_process(1.0/60)
	check(fruit.variety_id == "plum" and fruit.position.y > start.y and (fruit.rotation-initial_rotation).is_equal_approx(fruit.spin) and fruit.family.cut_value == 35 and fruit.durability == 3.5,"actual automatic compact Plum follows its weighted arc and actual authored spin with real quality and resistance")
	await capture("230-moving-plum"); pose(fruit); var family: CutFamily = fruit.family; var camera_pose: Transform3D = game.kitchen.camera.global_transform
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(fruit.durability == 2 and game.session.cuts == 0 and game.session.earnings == 0,"actual native starter plus cultivated sharpness damages Plum without paying before a split")
	await capture("231-plum-resistance"); await move_blade(Vector2(-3,0))
	check(game.ui.moving.filter(func(item): return item.get("group","") == game.resistance_group(family)).size() == 1 and game.ui.root.find_child("DamageIndicator",false,false).text == "1 more strike","rapid native resistant strokes update one current ordinary family label instead of stacking obsolete damage text")
	await move_blade(Vector2(3,0))
	check(game.session.cuts == 1 and is_equal_approx(game.session.earnings,43.75) and game.session.tomatoes_sliced == 1,"three actual mouse strokes split a resistant Plum for one cultivated 43.75 reward")
	check(game.ui.moving.filter(func(item): return item.get("group","") == game.resistance_group(family)).is_empty(),"actual native root split dismisses its obsolete resistance label before the cash reward")
	for step in range(12): game.fragments._physics_process(1.0/60)
	check(game.fragments.pieces.size() == 2 and game.fragments.pieces[0].position.distance_to(game.fragments.pieces[1].position) > .1,"actual Plum halves separate and tumble while retaining thick twin-gallery interiors")
	await capture("232-plum-open-interiors")
	var at: Vector3 = game.fragments.pieces[0].global_position; game.knife.reset()
	await move_blade(Vector2(at.x-2,at.y)); await move_blade(Vector2(at.x+2,at.y))
	check(game.session.cuts == 1 and game.fragments.pieces[0].durability == .25,"actual mouse strike respects the new thick fragment resistance before recut income")
	await move_blade(Vector2(at.x-2,at.y)); await move_blade(Vector2(at.x+2,at.y))
	check(game.session.cuts == 2 and is_equal_approx(game.session.earnings,87.5) and game.session.tomatoes_sliced == 1 and game.kitchen.camera.global_transform == camera_pose,"actual resistant Plum recut earns 87.50 with one unique family, bounded cuts and fixed camera")
	await capture("233-resistant-plum-recut"); game.session.advance(100); game.finish_round(); await frames()
	await click(instrument_icon()); await select_product("chef"); await click(game.ui.content.find_child("Equip_chef",true,false))
	check(game.progress.strength() == 3 and game.progress.equipped_combo_multiplier() == 1,"actual saved native Chef equip composes ordinary sharpness without a combo multiplier")
	await click(find_button(game.ui.content,"Back to the cutting board")); fruit = automatic_plum(); pose(fruit)
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(fruit.durability == .5 and game.session.cuts == 0 and game.knife.edge.size() == 5,"actual unprepared Chef blade leaves only half a point of Plum resistance with no premature payout")
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(game.session.cuts == 2 and is_equal_approx(game.session.earnings,87.5),"actual unprepared Chef root and recut need fewer strikes but keep the same captured payout")
	game.session.advance(100); game.finish_round(); await frames(); await click(instrument_icon()); await select_product("chef"); await click(game.ui.content.find_child("Prepare_chef",true,false))
	await click(game.ui.content.find_child("BuyModification_honing_kit",true,false)); await click(game.ui.content.find_child("Apply_honing_kit",true,false))
	check(game.progress.strength() == 3.5 and game.progress.knife_modification("chef") == "honing_kit","actual separate native preparation reaches Plum resistance once without changing its reach or per-cut value")
	await capture("234-prepared-chef"); await click(find_button(game.ui.content,"Back to cutting")); fruit = automatic_plum(); pose(fruit)
	await move_blade(Vector2(-3,0)); await move_blade(Vector2(3,0))
	check(game.session.cuts == 1 and is_equal_approx(game.session.earnings,43.75) and game.audio.sounds.has("chef_slice"),"actual prepared Chef makes a single clean Plum root split with its original crisp slice cue available")
	await move_blade(Vector2(-3,0)); game.session.advance(100); game.finish_round(); await frames(); var restored := Progression.new()
	check(game.store.load_into(restored) and restored.equipped_knife == "chef" and restored.strength() == 3.5 and is_equal_approx(restored.prestige.cycle_earnings,262.5),"three actual native resistant/prepared rounds bank 262.50 and reload paid Plum/Chef/preparation")
	await capture("235-chef-results"); await click(instrument_icon()); await select_product("santoku"); await click(game.ui.content.find_child("Buy_santoku",true,false))
	await click(game.ui.content.find_child("Equip_santoku",true,false)); await click(catalog_icon()); await click(find_button(game.ui.content,"Money")); await cultivate("better_prices"); await click(find_button(game.ui.content,"Combos")); await cultivate("combo_cash")
	check(game.progress.equipped_combo_multiplier() == 1.5 and game.progress.reward(2,35) == 56.44,"actual paid native Santoku still activates its cultivated bonus when separately equipped")
	await click(instrument_icon()); await select_product("chef"); await click(game.ui.content.find_child("Equip_chef",true,false))
	check(game.progress.equipped_combo_multiplier() == 1 and game.progress.reward(2,35) == 55.13 and game.progress.strength() == 3.5,"actual native return to Chef removes the other knife's passive while retaining its own preparation")
	game.progress.complete_round(float(game.progress.prestige.config.threshold),1,1); await click(archive_icon()); await click(game.ui.content.find_child("PreviewPrestige",true,false)); game.ui.prestige_confirmation.get_ok_button().pressed.emit(); await frames(6)
	check(not game.progress.harvest.unlocked("plum",game.progress.levels) and game.progress.owned_knives == ["rusty_butter"] and game.progress.owned_modifications.is_empty() and game.ui.list_views.is_empty(),"native confirmed prestige clears new normal variety/equipment/preparation and stale collection views")
	await permanent("permanent_slice_value"); game.show_settings(); await frames(); await click(game.ui.content.find_child("Setting_reduced_motion",true,false)); await click(game.ui.content.find_child("Setting_reduced_effects",true,false))
	await click(instrument_icon()); await select_product("chef")
	check(not game.ui.content.get_node("EquipmentPreview").is_processing() and game.ui.content.find_child("EquipmentSpecial",true,false).text == "Special  ·  None","new-cycle Chef product is framed and still under Reduced Motion without a free passive")
	await capture("236-chef-reduced-motion"); game.show_home(); await frames(); await click(find_button(game.ui.content,"New game")); game.ui.confirmation.get_ok_button().pressed.emit(); await frames(6)
	check(game.progress.prestige.levels.is_empty() and game.progress.settings.reduced_motion and game.progress.settings.reduced_effects and game.ui.root_views.is_empty(),"native New Game clears permanent gates/root views while retaining accessibility preferences")
	game.queue_free(); await frames(12); print("CHEF RENDER RESULT: ",failures," failures"); quit(1 if failures else 0)
